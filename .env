# =============================================================
# track-service · .env
# =============================================================

# ---------- Servidor ----------
PORT=3000
# Días que se conservan los historiales (logs/*.jsonl) antes de purgarse
RETENTION_DAYS=15

# ---------- fm-track (origen de los datos GPS) ----------
FM_TRACK_BASE_URL=https://api.fm-track.com
# Tenant primario — TMS, WISE
FM_TRACK_API_KEY=yA-mLN09psTSq2vTbkXoEDTrppHopLYU
# Tenant secundario — DRIVIN, BERMANN, DS (pega aquí la nueva key)
FM_TRACK_API_KEY_2=ybPonYAEtfLS3_afiCueL-fIwDzQwnNV
# fm-track exige version=1 o version=2 en cada request
FM_TRACK_VERSION=1

# ---------- API destino genérica (solo para tests sueltos en "Explorar API") ----------
TARGET_API_URL=
TARGET_API_KEY=

# ---------- Falabella TMS · GPS Aggregator ----------
FALABELLA_TEST_URL=https://tms-uat-services.falabella.supply/api/v1/ms-tms-gps-aggregator/gps/position
FALABELLA_PROD_URL=https://tms-services.falabella.supply/api/v1/ms-tms-gps-aggregator/gps/position

# Credenciales TEST (las entregó Falabella en su correo)
FALABELLA_APIKEY=wQ20Lk4TA5TqZYoKRDThzfQbe10gMfQ8
FALABELLA_AUTHORIZATION=93d2724f-d826-44a4-a753-d1939b86e4b1

# Credenciales PROD (las entregarán tras validar integración en TEST)
FALABELLA_PROD_APIKEY=e43OKN0sn89WLFerCCzVSkDwxF6VcOvB
FALABELLA_PROD_AUTHORIZATION=be04a451-8ed7-45c7-bc1a-3f9de2c84dd1

# Datos del prestador GPS — Falabella los exige en cada payload
# FALTA: pon tu RUT/DNI y el nombre con el que te identificas como prestador
FALABELLA_PROVIDER_DNI=76.085.282-1
FALABELLA_PROVIDER_NAME=Proaseg

FALABELLA_X_COUNTRY=CL
FALABELLA_USER_AGENT=gps/1.0.0
# Zona horaria para timestamp del payload (default: America/Santiago, ISO con offset)
FALABELLA_TIMEZONE=America/Santiago

# Grupos fm-track visibles en el catálogo general (Resumen, Vehículos).


# Vacío = todos. Ejemplo: ALLOWED_GROUPS=TMS,wise
ALLOWED_GROUPS=TMS,WISE,DRIVIN,BERMANN,DS
# Whitelist específica por cliente (fallback a ALLOWED_GROUPS si está vacía)
FALABELLA_GROUPS=TMS
WISE_GROUPS=WISE
DRIVIN_GROUPS=DRIVIN
BERMANN_GROUPS=BERMANN

# ---------- Wise (Wisetrack) ----------
WISE_API_URL=https://gw2.wisetrack.cl/Sotraser/1.0/InsertarPosicion
# Token Bearer que entregará Wisetrack
WISE_API_TOKEN=01c098ea-e36e-474c-83e3-4afde0411238
# Zona horaria para formatear fecha_hora en el payload (default: America/Santiago)
WISE_TIMEZONE=America/Santiago

# ---------- Drivin ----------
DRIVIN_API_URL=https://external.driv.in/api/external/v2/positions
# X-API-Key entregada por Drivin
DRIVIN_API_KEY=ybPonYAEtfLS3_afiCueL-fIwDzQwnNV

# ---------- Bermann ----------
BERMANN_API_BASE=https://concentrador.bermann.cl/integracion_bermann/api
# Credenciales del cliente externo en Bermann (auth en 2 pasos: /auth → token → /data/insert)
BERMANN_ID_CLIENTE_EXTERNO=
BERMANN_USERNAME=
BERMANN_PASSWORD=

# ---------- Login ----------
# Cuentas que pueden entrar: usuario:clave separados por coma.
# Vacío = sin login (app pública). Evita ':' y ',' en las claves.
AUTH_USERS=jc.novoa.b@gmail.com:GPSproaseg_1453
# Secret para firmar las sesiones — pon un valor largo y aleatorio (define uno fijo en prod).
AUTH_SECRET=a6345086e944e72fa9402018e23d55981b01ade9ead604a896f1c986a754c8e8
# Horas que dura la sesión antes de pedir login de nuevo
AUTH_SESSION_HOURS=96

POSTGRES_PASSWORD=a6345086e944e72fa9402018e
